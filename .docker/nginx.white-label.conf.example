# Modelo para o Nginx DO HOST (/etc/nginx/sites-available/), nao o proxy do Compose.
# Primeiro configure DNS e emita um certificado PROPRIO para este hostname.
# Este arquivo nao e carregado automaticamente nem altera a configuracao atual.
server {
    listen 80;
    server_name app.revee.elevdata.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://app.revee.elevdata.com.br$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name app.revee.elevdata.com.br;
    ssl_certificate /etc/letsencrypt/live/app.revee.elevdata.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.revee.elevdata.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 50M;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /static/ {
        alias /var/www/west/staticfiles/;
    }
    # Apenas imagens publicas. Anexos financeiros ficam no armazenamento privado
    # e sao entregues pelas views autenticadas e limitadas ao CNPJ do ambiente.
    location /media/ {
        alias /var/www/west-media/;
        expires 7d;
    }
    location / {
        proxy_pass http://127.0.0.1:8012;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
    }
}
