# Copy to .docker/.env.production on the server and replace CHANGE_ME values.
# Never commit .docker/.env.production.

DOMAIN=app.seu-dominio.com.br
EMAIL=admin@app.seu-dominio.com.br
ENABLE_SSL=auto

APP_HOST_PORT=127.0.0.1:8000

SECRET_KEY=CHANGE_ME
OMIE_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME

ALLOWED_HOSTS=app.seu-dominio.com.br,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=west_bi
POSTGRES_USER=west_user
POSTGRES_PASSWORD=CHANGE_ME

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
