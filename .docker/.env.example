# Copy to .docker/.env.production on the server and replace CHANGE_ME values.
# Never commit .docker/.env.production.

DOMAIN=app.example.com
EMAIL=admin@example.com
ENABLE_SSL=auto

PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_CLIENT_MAX_BODY_SIZE=50M

SECRET_KEY=CHANGE_ME
OMIE_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME

ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=west_bi
POSTGRES_USER=west_user
POSTGRES_PASSWORD=CHANGE_ME

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
